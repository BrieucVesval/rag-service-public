# Copy to .env and fill in. Never commit .env.

# Mistral API key (console.mistral.ai, free "Experiment" tier is enough)
MISTRAL_API_KEY=

# Pipeline settings (optional, defaults in src/rag/config.py)
# RAG_PROCESSED_DIR=data/processed/service_public
