# RAG_CHUNK_OVERLAP=200
# RAG_CHROMA_DIR=data/indexes/chroma
# RAG_EMBEDDING_MODEL=mistral-embed
# RAG_EMBEDDING_BATCH_SIZE=32
# RAG_MISTRAL_REQUESTS_PER_MINUTE=50
# RAG_MISTRAL_TIMEOUT_S=60
# RAG_MISTRAL_MAX_RETRY_S=120
